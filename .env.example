# Supabase project (Settings -> API). Publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used for PIN login rate limiting.
SUPABASE_SECRET_KEY=

# Domain for synthetic emails used by phone + PIN login.
PIN_EMAIL_DOMAIN=pin.konveko.internal
